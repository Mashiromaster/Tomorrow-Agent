{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pagent-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // Metadata-only observability. Request/response bodies are never logged
  // (see src/metrics.ts) — that is the technical backing for the privacy
  // promise in IMPLEMENTATION.md §8/§9.
  "observability": { "enabled": true },

  "kv_namespaces": [
    // Attested App Attest public keys, keyed by keyId. One record per device.
    { "binding": "DEVICES", "id": "REPLACE_WITH_KV_ID", "preview_id": "REPLACE_WITH_KV_PREVIEW_ID" },
    // Monthly request counters, keyed by device + month.
    { "binding": "QUOTA", "id": "REPLACE_WITH_KV_ID", "preview_id": "REPLACE_WITH_KV_PREVIEW_ID" }
  ],

  // ── Custom domain ──────────────────────────────────────────────────────
  //
  // **Not optional for this project.** The default `*.workers.dev` hostname is
  // DNS-poisoned from mainland China: it resolves to three different addresses
  // across resolvers (174.37.243.85, 185.60.216.50, 168.143.171.93), none of
  // them in Cloudflare's published ranges, while `cloudflare.com` itself
  // resolves correctly to 104.16.x. So the poisoning targets the hostname, not
  // Cloudflare as a whole — and a custom domain on Cloudflare's own edge IPs
  // is the documented way around it.
  //
  // This matters because `*.workers.dev` is what the *iOS app* would connect
  // to. A developer can work around it with a VPN; a user cannot. Leaving it
  // unset would mean shipping a product that fails for its intended audience,
  // discovered at device-test time rather than now.
  //
  // To enable: add the zone to Cloudflare (NS delegation), then uncomment and
  // set the hostname. `scripts/deploy.sh` reads it and reminds you if unset.
  //
  // "routes": [
  //   { "pattern": "pagent-proxy.example.com", "custom_domain": true }
  // ],

  "vars": {
    "APPLE_TEAM_ID": "REPLACE_TEAM_ID",
    "APP_BUNDLE_ID": "com.example.PAgent",
    // "development" accepts the aaguid "appattestdevelop" (Xcode/TestFlight
    // debug builds). Must be "production" before shipping, or a debug build
    // can mint tokens against the production key.
    "APP_ATTEST_ENV": "development",
    "UPSTREAM_BASE_URL": "https://api.deepseek.com/anthropic",
    // Recomputed against DeepSeek pricing — see docs/DEEPSEEK.md § Cost model.
    // 20/400 was sized against Opus at $5/MTok; the same spend now buys ~18×
    // more. 100 free plans cost ~$0.37/mo at worst (all v4-pro, all peak).
    "FREE_MONTHLY_REQUESTS": "100",
    "PRO_MONTHLY_REQUESTS": "2000"
  }

  // Secrets (set via `wrangler secret put`, never committed):
  //   DEEPSEEK_API_KEY  — injected into the upstream request
  //   JWT_SIGNING_KEY    — HMAC-SHA256 key for short-lived device tokens
}
