# Swift / SPM
.build/
.swiftpm/
DerivedData/

# Generated by `xcodegen generate` from ios/project.yml, which is the
# reviewable source of truth. Committing the project file as well would mean
# resolving merge conflicts in a blob nobody reads.
*.xcodeproj/
*.xcworkspace/

# Node / Workers
node_modules/
.wrangler/
.dev.vars

# Secrets. `wrangler secret put` is the only sanctioned path for
# ANTHROPIC_API_KEY and JWT_SIGNING_KEY — never a committed file.
*.env
.env.*
!.env.example

# macOS
.DS_Store

# Built by tools/make-app.sh, not source.
tools/PAgent Preview.app/
